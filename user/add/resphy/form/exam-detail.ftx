:horiz_container
	Date imported/entered :display_text $date_imported
	Source of data $source :dropdown [1=File import,2=Standard data entry,3=Reversibility data entry,4=Other data entry] {condition_test[0]=1,condition_action[0]=show,condition_target[0]=match_info;pdf_filename,condition_test[1]=3,condition_action[1]=show,condition_target[1]=patient_wheld_inhalers,default=2,readonly=1}
	Test-set details :display_text $test_set_details
	
:horiz_container $match_info {segments=4}
	Patient match $match_state :dropdown {readonly=1} [A=Auto,U=Unmatched,M=Manual]
	Match score $score :number {suffix=/15,readonly=1} 

PDF report file $pdf_filename :download_link {local_path=/local/resphy,link_path=/resphy/pdf,icon=icon-picture,no_file_text=No PDF file available for this exam}
		
:tab_container
	
	Test data :tab $tests
		:horiz_container
			Date of tests :date $exam_date {viewonly=1}
			Time of tests :time $exam_time {viewonly=1}
			
			
		lung function test $lung_function :encounter_grid {use_page=resphy:test,fields=test_type;predicted;pre_value;pre_pc_predicted;post_value;post_pc_predicted,use_parent=1,use_paging=1}
	
	Additional information :tab
		Patient measurements :fieldset $pmeas_fset {compress=1}
			:horiz_container
				Height :text $height {suffix=cm,size=4,viewonly=1}
				Weight :text $weight {suffix=kg,size=4,viewonly=1}

		Spirometry attributes :fieldset $spir_fset {compress=1}
			:horiz_container	
				Patient withheld inhalers :radio_buttons $patient_wheld_inhalers [Y=Yes,N=No,X=Not applicable] {viewonly=1,inline=1}
				Pred. values calculations :text $predicted_source {size=10,viewonly=1}
				Use corr. factor (90%)? $use_cfactor_90pc @cfactor_90pc :checkbox {viewonly=1}	
		
		Research related :fieldset $res_spec_fset {compress=1}
			:horiz_container
				Research specific exam? $research_specific @used_in_study :checkbox {viewonly=1,condition_test=1,condition_action=show,condition_target=study}
				"Specific study (optional)" $study :dropdown {dictionary=studylist,viewonly=1}

		Comments $comments :memo {size=100,rows=3,viewonly=1}

	Examination details :tab $exam_details
		
		:horiz_container
			Identifier $identifier :display_text {size=10} 
			First name $first_name :display_text {size=20} 
			Last name $last_name :display_text {size=20} 
			Date of birth $dob :display_text
		
		:horiz_container
			Consultant :display_text $consultant {readonly=1}
			
			
		Import filename $filename :text {viewonly=1}
		Import issues $issues :memo {size=80,height=5,viewonly=1}
