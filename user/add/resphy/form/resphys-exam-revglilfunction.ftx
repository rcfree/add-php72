:container $predicted_values {detail_field=source,detail_constant=3}

	Date entered $date_imported :hidden {default=now(),detail_field=date_imported}
	
	:horiz_container
		Date of tests* $date_of_tests :date {detail_field=exam_date,multi_field=test_date}
		Height* $height :number {detail_field=height}
		Predicted* $predicted :hidden {detail_field=predicted_source,detail_constant=GLI-2012}
		$test_set_details :hidden {detail_field=test_set_details,detail_constant=Reversibility PFTs (GLI-2012)}
		Comments $lf_comments :memo {rows=3,detail_field=comments}
		
	:horiz_container
		Research specific? $lf_research_specific :checkbox {condition_test=1,condition_action=show,condition_target=lf_study,detail_field=research_specific}
		"Study (optional)" $lf_study :dropdown {dictionary=studylist,detail_field=study}
		
	Predicted Values $pv_fset :fieldset {compress=1,width=98%}

		:horiz_container
			FEV<sub>1</sub> $pred_fev1 :number {display_text=Predicted FEV<sub>1</sub>,size=4,suffix=l,multi_no=1,multi_field=predicted,multi_constant[0]=test_type:FEV1,ajax-func=GliLungFunction}
			FVC $pred_fvc :number {display_text=Predicted FVC,size=4,suffix=l,multi_field=predicted,multi_no=2,multi_constant[0]=test_type:FVC}
			FEV<sub>1</sub>/FVC $pred_fev1_fvc :number {display_text=Predicted FEV<sub>1</sub>/FVC,size=4,suffix=l,multi_no=3,multi_field=predicted,multi_constant[0]=test_type:FEV1/FVC}
			Ethnicity $cfactor_90pc :radio_buttons [1=Caucasian,2=African-American,3=NE Asian,4=SE Asian,5 = Other/mixed] {empty_option=0,inline=1,detail_field=use_cfactor_90pc,default=1}

Patient withheld inhalers :radio_buttons $patient_wheld_inhalers [Y=Yes,N=No,X=Not applicable] {inline=1,condition_test=N,condition_target=pre_fev1_fset;pre_fvc_fset;pre_fev1_fvc_fset,condition_action=hide,detail_field=patient_wheld_inhalers}

:horiz_container  {segments=2}
	Pre-FEV<sub>1</sub> $pre_fev1_fset :fieldset {compress=1}

		:horiz_container
			Pre-FEV<sub>1</sub>* $pre_fev1 :number {fixed=2,size=4,suffix=l,multi_no=1,multi_field=pre_value,min=0.1,max=9}
			% predicted FEV<sub>1</sub> $pre_pc_pred_fev1 :expression {expression=(get('pre_fev1')/get('pred_fev1')*100),expression_fail_value=NULL,fixed=2,size=4,suffix=%,multi_no=1,multi_field=pre_pc_predicted,required=0}
	
	Post-FEV<sub>1</sub> $post_fev1_fset :fieldset {compress=1}
		:horiz_container
			Post-FEV<sub>1</sub>* $post_fev1 :number {fixed=2,size=4,suffix=l,multi_no=1,multi_field=post_value,min=0.1,max=9}
			% predicted FEV<sub>1</sub> $post_pc_pred_fev1 :expression {expression=(get('post_fev1')/get('pred_fev1')*100),expression_fail_value=NULL,fixed=2,size=4,suffix=%,multi_no=1,multi_field=post_pc_predicted,required=0}

:horiz_container {segments=2}		
	Pre-FVC :fieldset $pre_fvc_fset {compress=1}

		:horiz_container
			Pre-FVC* $pre_fvc :number {fixed=2,size=4,suffix=l,multi_no=2,multi_field=pre_value,min=0.1,max=9}
			% predicted FVC $pre_pc_pred_fvc :expression {expression=(get('pre_fvc')/get('pred_fvc')*100),expression_fail_value=NULL,fixed=2,size=4,suffix=%,multi_no=2,multi_field=pre_pc_predicted,required=0}
	
	Post-FVC :fieldset $post_fvc_fset {compress=1}

		:horiz_container
			Post-FVC* $post_fvc :number {fixed=2,size=4,suffix=l,multi_no=2,multi_field=post_value,min=0.1,max=9}
			% predicted FVC $post_pc_pred_fvc :expression {expression=(get('post_fvc')/get('pred_fvc')*100),expression_fail_value=NULL,fixed=2,size=4,suffix=%,multi_no=2,multi_field=post_pc_predicted,required=0}
	

:horiz_container {segments=2}

	Pre-FEV<sub>1</sub>/FVC $pre_fev1_fvc_fset :fieldset {compress=1}
	
		:horiz_container
			Pre-FEV<sub>1</sub>/FVC $pre_fev1_fvc :expression {fixed=2,size=4,suffix=l,multi_field=pre_value,multi_no=3,expression=get('pre_fev1')/get('pre_fvc')}
			"% predicted FEV<sub>1</sub>/FVC" $pre_pc_pred_fev1_fvc :expression {expression=(get('pre_fev1_fvc')/get('pred_fev1_fvc')*100),expression_fail_value=NULL,fixed=2,size=4,suffix=%,multi_field=pre_pc_predicted,multi_no=3,required=0}

	Post-FEV<sub>1</sub>/FVC $post_fev1_fvc_fset :fieldset {compress=1}
	
		:horiz_container
			Post-FEV<sub>1</sub>/FVC $post_fev1_fvc :expression {fixed=2,size=4,suffix=l,multi_field=post_value,multi_no=3,expression=get('post_fev1')/get('post_fvc')}
			"% predicted FEV<sub>1</sub>/FVC" $post_pc_pred_fev1_fvc :expression {expression=(get('post_fev1_fvc')/get('pred_fev1_fvc')*100),expression_fail_value=NULL,fixed=2,size=4,suffix=%,multi_field=post_pc_predicted,multi_no=3,required=0}

"Bronchodilator reversibility FEV<sub>1</sub>" :fieldset {compress=1}
	:horiz_container									
		$bronch_rev_fev1_pc	:expression	{suffix=%,size=4,expression=(get('post_fev1')-get('pre_fev1'))/get('pre_fev1')*100,expression_fail_value=NULL,fixed=1,data_type=number,display_title=Reversibility FEV1 %,multi_no=4,multi_field=pre_value,multi_constant[0]=test_type:reversibility %,multi_constant[1]=units:%}
		$bronch_rev_fev1_mls :expression {suffix=mls,size=4,expression=(get('post_fev1')-get('pre_fev1'))*1000,expression_fail_value=NULL,fixed=1,data_type=number,display_title=Reversibility FEV1 mls,multi_no=5,multi_field=pre_value,multi_constant[0]=test_type:reversibility mls,multi_constant[1]=units:mls}
