:horiz_container $measures_hc											
	Height*	$height	:number		{suffix=cm, size=4,min=100,max=200} <snomed:248333004>	
	Weight*	$weight	:number		{suffix=kg,size=4,min=20,max=2000}	<snomed:425024002>	
	:icon {class=icon-arrow-right}
	BMI	$bmi :expression {expression=(get('weight')/((get('height')/100) * (get('height')/100))).toFixed(1),size=4} <snomed:60621009>

"Fat-free mass" $fat_free_mass :number {suffix=kg,size=4,min=0,max=get('weight')} <snomed:248363008>	