Return to QoL summary..	$qol_return	:summary_page_link {parent_key=buttons}
Date* $snot22_date	:date {min=date_of_birth(),max=today(),default=today(),summary_obs=snot22_date}
Record score only $score_only :checkbox {condition_test[0]=1,condition_action[0]=hide,condition_target[0]=rhino_severity,condition_test[1]=1,condition_action[1]=enable,condition_target[1]=total_score}

$questions :container
	$rhino_severity :radio_group {col_width=8em,dictionary=snot22_severity}
		1. Need to blow nose $blow_nose* :radio_item {show_value=1}
		2. Nasal Blockage $nasal_block*  :radio_item {show_value=1}
		3. Sneezing* $sneezing :radio_item {show_value=1}
		4. Runny nose* $runny_nose :radio_item {show_value=1}
		5. Cough* $cough :radio_item {show_value=1}
		6. Post-nasal discharge* $pnasal_discharge :radio_item {show_value=1}
		7. Thick nasal discharge* $tnasal_discharge :radio_item {show_value=1}
		8. Ear fullness* $ear_fullness :radio_item {show_value=1}
		9. Dizziness* $dizziness :radio_item {show_value=1}
		10. Ear pain* $ear_pain :radio_item {show_value=1}
		11. Facial pain/pressure* $facial_pain :radio_item {show_value=1}
		12. Decreased sense of smell/taste* $dec_smell_taste :radio_item {show_value=1}
		13. Difficulty falling asleep* $diff_fall_asleep :radio_item {show_value=1}
		14. Wake up at night* $wake_up :radio_item {show_value=1}
		15. Lack of good night's sleep* $lack_sleep :radio_item {show_value=1}
		16. Wake up tired* $tired_wake :radio_item {show_value=1}
		17. Fatigue $fatigue* :radio_item {show_value=1}
		18. Reduced productivity* $red_product :radio_item {show_value=1}
		19. Reduced concentration* $red_concent :radio_item {show_value=1}
		20. Frustrated/restless/irritable* $frust_rest_irrita :radio_item {show_value=1}
		21. Sad* $sad :radio_item {show_value=1}
		22. Embarrassed* $embarrassed :radio_item {show_value=1}

Total score* $total_score :number {min=0,max=110,size=3,fixed=0,summary_obs=snot22_score,expression=sum('blow_nose;nasal_block;sneezing;runny_nose;cough;pnasal_discharge;tnasal_discharge;ear_fullness;dizziness;ear_pain;facial_pain;dec_smell_taste;diff_fall_asleep;wake_up;lack_sleep;tired_wake;fatigue;red_product;red_concent;frust_rest_irrita;sad;embarrassed')}
Status	$status	:internal {summary_obs=snot22_status,summary_type=status}