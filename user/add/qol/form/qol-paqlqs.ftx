Return to QoL summary..	$qol_return	:summary_page_link {parent_key=buttons}
Date* $paqlqs_date	:date {min=date_of_birth(),max=today(),default=today(),summary_obs=paqlqs_date}

:horiz_container
	Scores: :item
	Symptoms $symptoms_score :number {suffix=/70,min=0,max=70,size=2,fixed=0}
	Activity Limit. $act_limit_score :number {suffix=/35,min=0,max=35,size=2,fixed=0}
	Emotional Func. $emot_func_score :number {suffix=/42,min=0,max=42,size=2,fixed=0}

:horiz_container
	Means: :item
	Symptoms $symptoms_mean :expression {expression=get('symptoms_score')/7,suffix=/10,size=2,fixed=1}
	Activity Limit. $act_limit_mean :expression {expression=get('act_limit_score')/7,suffix=/5,size=2,fixed=1}
	Emotional Func. $emot_func_mean :expression {expression=get('emot_func_score')/7,suffix=/6,size=2,fixed=1}

Total score* $total_score :expression {expression=sum('symptoms_score;act_limit_score;emot_func_score'),size=3,fixed=0,summary_obs=paqlqs_score}
Status	$status	:internal {summary_obs=paqlqs_status,summary_type=status}