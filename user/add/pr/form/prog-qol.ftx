Hospital anxiety and depression scale (HADS) $hads_fset :fieldset

 $hc1 :table

  $th1 :table_head
   :markup
   :markup
   Visit Date $m1 :markup
   Status $m2 :markup
   A score $m3 :markup
   D score $m4 :markup
   Total $m5 :markup
   A mean $m6 :markup
   D mean $m7 :markup

  :table_row
   <b>Pre-PR</b> $pre_pr :markup
   Edit questionnaire.. $edit_hads_pre :page_link {section=prehads,complete_title=Read questionnaire..,new_title=Perform questionnaire..,incomplete_edit_title=Continue questionnaire..,incomplete_view_title=View incomplete questionnaire..}
   $hads_date_pre :display_text
   $hads_status_pre :display_text {default="New"}
   $hads_anxiety_score_pre :display_text {size=3}
   $hads_depression_score_pre :display_text {size=3}
   $hads_total_pre :display_text
   $hads_anxiety_mean_pre :display_text
   $hads_depression_mean_pre :display_text

  $hc2_post :table_row
   <b>Post-PR</b> $m11 :markup
   Edit questionnaire.. $edit_hads_post :page_link {section=posthads,complete_title=Read questionnaire..,new_title=Perform questionnaire..,incomplete_edit_title=Continue questionnaire..,incomplete_view_title=View incomplete questionnaire..}
   $hads_date_post :display_text
   $hads_status_post :display_text {default="New"}
   $hads_anxiety_score_post :display_text {size=3}
   $hads_depression_score_post :display_text {size=3}
   $hads_total_post :display_text
   $hads_anxiety_mean_post :display_text
   $hads_depression_mean_post :display_text

Chronic Respiratory Questionnaire (CRQ-SR) $crq_fset :fieldset

 :table

  :table_head
   :markup
   :markup
   Visit Date $vd :markup
   Status $st :markup
   Dyspnoea $dyspnoea :markup
   Fatigue $fatigue :markup
   Emotional $emotional :markup
   Mastery $mastery :markup
   Total $tot :markup

  $hc2 :table_row {segments=9}
   <b>Pre-PR</b> $pre_crq :markup
   Edit questionnaire.. $edit_crq :page_link {section=precrq,complete_title=Read questionnaire..,new_title=Perform questionnaire..,incomplete_edit_title=Continue questionnaire..,incomplete_view_title=View incomplete questionnaire..}
   $crq_date_pre :display_text
   $crq_status_pre :display_text {default="New"}

   :container
    $crq_d_score_pre :display_text {size=3}
    $crq_d_mean_pre :display_text {size=3}

   :container
    $crq_f_score_pre :display_text {size=3}
    $crq_f_mean_pre :display_text {size=3}

   :container
    $crq_e_score_pre :display_text {size=3}
    $crq_e_mean_pre :display_text {size=3}

   :container
    $crq_m_score_pre :display_text {size=3}
    $crq_m_mean_pre :display_text {size=3}
   $crq_total_pre :display_text {size=3}

  $tr_post_crq :table_row {segments=9}
   <b>Post-PR</b> $post_crq :markup
   Edit questionnaire.. $edit_crq_post :page_link {section=postcrq,complete_title=Read questionnaire..,new_title=Perform questionnaire..,incomplete_edit_title=Continue questionnaire..,incomplete_view_title=View incomplete questionnaire..}
   $crq_date_post :display_text
   $crq_status_post :display_text {default="New"}

   :container
    $crq_d_score_post :display_text {size=3}
    $crq_d_mean_post :display_text {size=3}

   :container
    $crq_f_score_post :display_text {size=3}
    $crq_f_mean_post :display_text {size=3}

   :container
    $crq_e_score_post :display_text {size=3}
    $crq_e_mean_post :display_text {size=3}

   :container
    $crq_m_score_post :display_text {size=3}
    $crq_m_mean_post :display_text {size=3}
   $crq_total_post :display_text {size=3}
   
