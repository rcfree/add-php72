Action*	$action_type	:dropdown	{dictionary=actionlist,condition_test[0]=studyenrol,condition_action[0]=show,condition_target[0]=action_study_no,condition_test[1]=withdraw;notinter;studycomp,condition_action[1]=update,condition_target[1]=action_status,condition_target_value[1]=2,disable_on_update=1}
Date action recorded	$date_recorded	:hidden							{max=today(),readonly=1,col_title=Record date}
Created by	$action_created_by	:hidden	@created_by						{default=current_user(),readonly=1}

:horiz_container									{col_title=Current status}
	Current action status*	$action_status	@current_status :radio_buttons	{dictionary=actionstatus,condition_test[0]=1,condition_action[0]=update,condition_target[0]=action_date_scheduled,condition_target_value[0]=today(),condition_test[1]=2;3,condition_action[1]=update,condition_target[1]=action_end_date,condition_target_value[1]=today(),condition_test[2]=2,condition_action[2]=enable,condition_target[2]=action_study_no,inline=1}
	Study number	$action_study_no	@study_no :text				{size=20}
	
:horiz_container									
	Date action scheduled	$action_date_scheduled	@date_scheduled :date									{col_title=Scheduled date}
	Action end date	$action_end_date	@end_date :date						today()			{col_title=Action date}
	
Comments	$description	:memo								{height=6,size=80}									
-$add_to_study