{
    "name": "clinicle/core",
    "description": "ClinicLE core",
    "bin": ["bin/clinicle"],
    "require": {
        "php": ">=5.3.3",
		"apache/log4php": "^2.1",
		"leicrespbru/lrbtools":"^1.2",
"pimple/pimple": "^3.0",
        "clinicle/common":"^1.3",
	"clinicle/migrate":"^1.0",
	"clinicle/manage":"^1.5",
	"clinicle/ajax":"^1.0",
		"clinicle/email":"^1.0",
		"clinicle/datafile":"^1.0",
		"symfony/filesystem":"^2.7",
		"symfony/finder":"^2.7",
		"symfony/process":"^2.7.",
		"symfony/event-dispatcher":"^2.7",
		"symfony/http-foundation":"^2.7",
        "matthiasmullie/minify": "^1.3"
    },
	"autoload": {
        "classmap": ["lib"],
		"psr-4":{
			"ClinicLE\\":"src/"
		}
    },
	"replace":{
		"clinicle/system":"^1.3"
	}
