{
    "name": "clinicle/episode",
    "description": "ClinicLE episode section support",
	"type": "clinicle-module",
	"require":{
		"clinicle/core":"^2.11",
		"clinicle/install":"^1.2",
		"clinicle/manage":"^1.5"
	},
	"autoload": {
        "classmap": ["lib"],
		"psr-4":{
			"ClinicLE\\Episode\\":"src/"
		}
    },
	"repositories": [
        {
            "type": "composer",
            "url": "http://projects.ilh.le.ac.uk/satis"
        },
		 {
            "type": "vcs",
            "url": "http://bitbucket.org/clinicle/migrate"
        }
    ],
	"prefer-stable":true,
	"minimum-stability":"dev",
	"config":{
		"secure-http":false
		
    }
}
