{
"name": "clinicle/monitor",
    "description": "ClinicLE monitor wrapper",
    "authors": [
        {
            "name": "Rob Free",
            "email": "rcf8@le.ac.uk"
        }
    ],
    "require": {
       "ramsey/uuid": "^2.9",
       "clinicle/common":"^1.0",
