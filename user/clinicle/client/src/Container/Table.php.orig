<?php
namespace ClinicLE\Client\Container;
use ClinicLE\Client\Container\Cell\AbstractCell;

/**
 * Created by PhpStorm.
 * User: rcf8
 * Date: 10/11/2016
 * Time: 10:14
 */
class Table
{
    private $paged = false;
    private $title;
    private $loader = false;
    private $dataSetName;
    private $dataItemName;
    private $cells = array();

    /**
     * @return array
     */
    public function getCells()
    {
        return $this->cells;
    }
    
    function __construct($title, $dataSetName, $dataItemName) {
        $this->title = $title;
        $this->dataSetName = $dataSetName;
        $this->dataItemName = $dataItemName;
    }
    function createHtml() {
        $html = new \ADD_Content_Html();
        $html->addTextElement("div","",array("ng-show"=>"gridError","ng-bind-html"=>"gridError","class"=>"alert alert-error"));
        $html->addTextElement("div","",array("ng-show"=>"gridWarning","ng-bind-html"=>"gridWarning","class"=>"alert alert-warning"));
        if($this->isPaged()) {
            $html->addTextElement("button","<i class='icon-backward'></i>&nbsp;Prev",array("class"=>"btn","type"=>"button","ng-click"=>"previous()","ng-show"=>"loading==false && less"));
            $html->addTextElement("button","<i class='icon-forward'></i>&nbsp;Next",array("class"=>"btn","type"=>"button","ng-click"=>"next()","ng-show"=>"loading==false && more"));
        }
        $html->addTextElement("div","Sorry no ".$this->getTitle()."s were found matching your search.",array("ng-show"=>"total==0 && !gridError","class"=>"alert alert-error"));

        $ajaxLoader = new \ADD_Content_Html();
        $ajaxLoader->startElement("p",array("ng-show"=>"loading","class"=>"muted"));
        $ajaxLoader->addHtml("Loading &nbsp;");
        $ajaxLoader->addElement("img",array("src"=>"/module/clinicle/client/images/ajax-loader.gif"));
        $ajaxLoader->endElement("p");
        $html->addHtml($ajaxLoader);
        $html->addTextElement("div",($this->isPaged() ? "{{start}} - {{end}} of ":"")."{{total}} ".$this->getTitle()
        ."{{ "
        .$this->getDataSetName().".length == 1 ? '' : 's' }}",array("ng-show"=>"loading==false && ".$this->getDataSetName().".length>0","class"=>"alert alert-success"));

        $headings = array();
        foreach($this->getCells() as $cell) {
            $headings[]=$cell->getHeading();
        }
        $helper = new \ADD_Content_Html_TableHelper("",array("ng-show"=>$this->getDataSetName().".length>0 && loading==false"));
        $helper->setHeadings($headings);
        //Update number $update_no :grid_add_button {icon=icon-edit,refresh=actions;study_details;action_options,modal_width=700,use_page=research:action-updateno,use_parent=1}
/*
        $page = \CLE::sys()->getPageFromPim("research:ssummary");
        $addButton = new \ADD_Field_GridAddButton(array("Field"=>"add_{{ patient.study_id }}","Title"=>"Update no..","Settings"=>
            array("use_page"=>"research:action-updateno","refresh"=>"research-search")));
        $buttons = new \ADD_Content_Html();
        $addButton->setSectionId("{{ patient.study_id }}");
        $addButton->setPatientId("{{ patient.patient_id }}");

        $addButton->createHtml($buttons,$page);
*/
        $rowData = array();
        foreach($this->getCells() as $cell) {
            $rowData[]=$cell->getCell();
        }

        $helper->addRow(array(
            "data"=>$rowData,
            "attrs"=>$this->getTableAttrs()
        ));

        $html->addHtml($helper->create());

        $html->endElement("div");
        return $html;
    }

    function getTableAttrs() {
        return array("ng-repeat"=>$this->getDataItemName()." in ".$this->getDataSetName());
    }
    /**
     * @return boolean
     */
    public function isPaged()
    {
        return $this->paged;
    }

    /**
     * @param boolean $paged
     */
    public function setPaged($paged)
    {
        $this->paged = $paged;
    }

    /**
     * @return mixed
     */
    public function getTitle()
    {
        return $this->title;
    }

    /**
     * @param mixed $title
     */
    public function setTitle($title)
    {
        $this->title = $title;
    }

    /**
     * @return boolean
     */
    public function isLoader()
    {
        return $this->loader;
    }

    /**
     * @param boolean $loader
     */
    public function setLoader($loader)
    {
        $this->loader = $loader;
    }

    /**
     * @return mixed
     */
    public function getDataSetName()
    {
        return $this->dataSetName;
    }

    /**
     * @param mixed $dataSetName
     */
    public function setDataSetName($dataSetName)
    {
        $this->dataSetName = $dataSetName;
    }

    /**
     * @return mixed
     */
    public function getDataItemName()
    {
        return $this->dataItemName;
    }

    /**
     * @param mixed $dataItemName
     */
    public function setDataItemName($dataItemName)
    {
        $this->dataItemName = $dataItemName;
    }

    function addCell(AbstractCell $cell) {
        $cell->init($this);
        $this->cells[]=$cell;
    }
}