	"require":{
		"clinicle/core":"~2.7",
		"add/patient":"~1.0",
		"clinicle/install":"~1.0",
		"clinicle/client":"~1.6",
		"clinicle/report":"~1.1",
		"add/concept":"~1.0",
		"add/qol":"~2.4",
		"add/inv":"~2.0",
		"add/med":"~1.1",
		"add/history_status":"~1.0",
		"clinicle/remote":"~1.0",
