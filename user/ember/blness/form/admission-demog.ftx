:tab_container
	Enrolment :tab $enrol_tab
		Study number* :ember_number $study_number {ajax-func=EmberNumber}

		:horiz_container $enrolled_times
			Date enrolled* :date $enrolled_date {min=date_of_birth(),max=today()}
			Time enrolled* :time $enrolled_time
			Date/time enrolled* :expression $enrolled_datetime {size=16,as_string=1,expression=get('enrolled_date').toString() + " " + get('enrolled_time').toString()}


	General information :tab $gen_tab
		Previous/current occupation $prev_curr_occupation :text
		Age left education $age_left_education :number {min=1,max=100}

	Smoking history :tab $sh_tab
		Add to smoking history :grid_add_button {refresh=smoking_items,use_page=history:smoking,linkfield=link_smoking}

		smoking history item $smoking_items :encounter_grid {use_page=history:smoking,fields=date_recorded;smoking_status;pack_year_calc;smoking_item_type;from_year;to_year;pack_years,no_parent=1,before_row_actions=LinkRecord,linkfield=link_smoking,link_display_field=date_recorded}
		Smoking history item* :link_record $link_smoking {linked_grid=smoking_items}

	Vital signs :tab $cd_tab
		:horiz_container
			Date of vital signs* $date_vital_signs :date
			Time of vital signs $time_vital_signs :time

		:horiz_container $hc1
			Height* :number
			Weight* :number
			&rarr; $arrow :item
			BMI :number {viewonly=1,expression=(get('weight')/((get('height')/100) * (get('height')/100))).toFixed(1),expression_fail_value=-}

		:horiz_container
			Blood pressure :item
			$bp_top :number
			"/" :item
			$bp_bottom :number {suffix=mmgHg}

		Temperature :number {fixed=1,suffix=&#176;,min=10,max=50}

		Heart rate (non-ECG) $non_ecg_heart_rate :number
		Respiratory rate $resp_rate :number {suffix=breaths/min}

		NIV $niv :yes_no

		Past O<sub>2</sub> therapy $past_o2_therapy @past_hist_o2_use :radio_buttons [1=none,2=LTO,3=ambulatory,4=palliative] {inline=1}

		SpO<sub>2</sub> on air :number $spo2 @spo2_on_air {suffix=%,length=3,min=1,max=100}

		On supplementary O<sub>2</sub> $on_supo2 :yes_no
		SpO<sub>2</sub> on supplementary O<sub>2</sub> :number $spo2_on_supo2 {suffix=%,length=3,min=1,max=100}

		:horiz_container
			O<sub>2</sub> delivery method :dropdown [1=Venturi,2=Hudson,3=Nasal cannula] {condition_test[0]=1,condition_action[0]=show,condition_target[0]=o2_reading_pc,condition_test[1]=2;3,condition_action[1]=show,condition_target[1]=o2_reading_litres}

			O<sub>2</sub> reading :number $o2_reading_pc @o2_reading_percent {suffix=%}
			O<sub>2</sub> reading :number $o2_reading_litres {suffix=l}

		:horiz_container
			Cognitive impairment on admission :yes_no
			Cognitive impairment at consent :yes_no

-Meets study criteria :yes_no $meets_study_criteria {condition_test=Y,condition_action=show,condition_target=enrolled_times}
-Study number prefix :dropdown [GGH=GGH,DDU=DDU,CAU=CAU] {size=5}
