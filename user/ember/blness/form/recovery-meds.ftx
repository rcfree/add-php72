:tab_container
	Prescription drugs :tab $tab1
		Add prescription drug $add_gen_drug :grid_add_button {refresh=general_drugs,modal_width=700,use_page=med:presdrugitem,allow_add_another=1}
		Show inactive drugs :filter_switch $show_inactive {target_grid=general_drugs,off_filter=drug_type|eq|1+current_status|eq|1,on_filter=drug_type|eq|1}
		prescription drug $general_drugs :encounter_grid {filter[0]=drug_type|eq|1,filter[1]=current_status|eq|1,use_page=med:drugitem,fields=drug_details;dose;frequency;duration,condition_field=current_status,description=prescription drug,before_row_actions=DateCreated,after_row_actions=StartDateSummary;EndDateSummary;InactivateRecord,parent_type=med:general,row_condition=current_status|eq|2|inactive}

	Non-prescription drugs :tab $tab2
		Add non-prescription drug $add_nonpresc_drug :grid_add_button {refresh=otc_drugs,modal_width=700,use_page=med:otcdrugitem,allow_add_another=1}

		Show inactive drugs :filter_switch $hide_inactive_otc {target_grid=otc_drugs,off_filter=drug_type|eq|2+current_status|eq|1,on_filter=drug_type|eq|2}
		non-prescription drug $otc_drugs	:encounter_grid {use_page=med:otcdrugitem,fields=drug_details;dose;frequency;duration,condition_field=current_status,condition_class=inactive,row_condition=current_status|eq|2|inactive,filter[0]=drug_type|eq|2,filter[1]=current_status|eq|1,before_row_actions=DateCreated,after_row_actions=StartDateSummary;EndDateSummary;InactivateRecord,parent_type=med:general}