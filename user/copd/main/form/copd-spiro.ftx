:container $predicted_values {detail_field=source,detail_constant=2}

	Date entered $date_imported :hidden {default=now(),detail_field=date_imported}
	
	:horiz_container
		Date of tests* $date_of_tests :date {detail_field=exam_date,multi_field=test_date}
		Height(if known) $height :number {detail_field=height,min=60,max=272}
		Predicted* $predicted :hidden {detail_field=predicted_source,detail_constant=Manual}
		$test_set_details :hidden {detail_field=test_set_details,detail_constant=COPD entry}
		Comments $lf_comments :memo {rows=3,detail_field=comments}

:horiz_container

	FEV<sub>1</sub> $fev1_fset :fieldset {compress=1}

		:horiz_container
			FEV<sub>1</sub>* $fev1 :number {fixed=2,size=4,suffix=l,multi_no=1,multi_field=pre_value,min=0.1,max=9}
			% predicted FEV<sub>1</sub> $pc_pred_fev1 :number {fixed=2,size=4,suffix=%,multi_no=1,multi_field=pre_pc_predicted,required=0,min=0,max=150}

	FVC :fieldset $fvc_fset {compress=1}

		:horiz_container
			FVC* $fvc :number {fixed=2,size=4,suffix=l,multi_no=2,multi_field=pre_value,min=0.1,max=9}
			% predicted FVC $pc_pred_fvc :number {fixed=2,size=4,suffix=%,multi_no=2,multi_field=pre_pc_predicted,required=0,min=0,max=150}

FEV<sub>1</sub>/FVC $fev1_fvc_fset :fieldset {compress=1}

	:horiz_container
		FEV<sub>1</sub>/FVC $fev1_fvc :expression {fixed=2,size=4,suffix=l,obsField=pre_value,encNo=3,expression=get('fev1')/get('fvc')*100,multi_no=3,multi_field=pre_value}
		% predicted FEV<sub>1</sub>/ FVC $pc_pred_fev1_fvc :number {fixed=2,size=4,suffix=%,multi_no=3,multi_field=pre_pc_predicted,required=0,min=0,max=150}